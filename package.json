  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "npm run lint:toasts && npm run lint:api-request-json && npm run lint:version && npm run lint:traefik && npm run lint:dokploy-app-labels && npm run lint:healthcheck && npm run lint:slow-save && npm run lint:slow-save-payload && npm run lint:db-pool && npm run lint:proxy-timeouts && npm run lint:self-hosting-traefik && npm run lint:heavy-imports && npm run lint:i18n && npm run lint:doc-dates && npm run lint:schema && vite build && esbuild server/index.ts --platform=node --packages=external --bundle --splitting --format=esm --outdir=dist && tsx scripts/bundle-runtime-docs.ts && node scripts/verify-prod-bundle.mjs",
    "build:typed": "npm run check && npm run build",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --extendedDiagnostics",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:version": "tsx scripts/check-managed-version-markers.ts",
    "lint:toasts": "tsx scripts/check-toast-helper-usage.ts",
    "lint:api-request-json": "tsx scripts/check-api-request-json-usage.ts",
