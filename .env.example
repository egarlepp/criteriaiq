# ============================================================================
# CriteriaIQ — Self-Hosting Environment Reference
# ============================================================================
# All variables are OPTIONAL on first install. Run the in-app setup wizard at
# /setup and we'll generate sane defaults for you (stored encrypted in
# data/db-config.json). Set them here when you want infrastructure-as-code,
# secret rotation via your hosting platform, or to bypass the wizard entirely.

# ----------------------------------------------------------------------------
# Database (REQUIRED for non-wizard installs)
# ----------------------------------------------------------------------------
# Standard PostgreSQL connection string. Works with Neon, Supabase, Railway,
# AWS RDS, or self-hosted Postgres 14+.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Maximum number of clients in the Postgres connection pool. Defaults to 10
# (the pg driver default). Raise this on busier installs where long-running
# scheduled jobs (email automation, table sync, AI risk scoring) can hold all
# 10 clients at once and block the next admin write — see
# docs/guides/dokploy-traefik-timeouts.md Step 3. Accepted range: 1–1000.
# Values >1000 are clamped down to 1000; non-numeric, missing, zero, or
# negative values fall back to 10. The boot log prints the resolved value
# (and flags any clamp/fallback) as `[DB] Connection pool max=…`.
# DB_POOL_MAX=25

# ----------------------------------------------------------------------------
# Application Secrets (auto-generated by the wizard if unset)
# ----------------------------------------------------------------------------
# 96+ hex characters. Generate with:  openssl rand -hex 48
SESSION_SECRET=

# Exactly 64 hex characters. Used for AES-256-GCM at-rest encryption of
# WebAuthn challenges, MFA secrets, and the bootstrap connection URL.
# Generate with:  openssl rand -hex 32
ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# Public URL (auto-detected from window.location at the wizard step)
# ----------------------------------------------------------------------------
# The canonical address users / email links / WebAuthn passkeys will see.
# Use HTTPS in production. No trailing slash.
PUBLIC_APP_URL=https://app.example.com

# Optional WebAuthn overrides — by default these derive from PUBLIC_APP_URL.
# WEBAUTHN_RP_ID=app.example.com
# WEBAUTHN_RP_NAME=CriteriaIQ
# WEBAUTHN_ORIGIN=https://app.example.com

# Optional Salesforce OAuth redirect URI override. By default this derives
# from PUBLIC_APP_URL as ${PUBLIC_APP_URL}/api/auth/salesforce/callback.
# Set this only if Salesforce auth needs a different host than the rest of
# the app (e.g. routed through a separate reverse-proxy hostname).
# SALESFORCE_REDIRECT_URI=https://app.example.com/api/auth/salesforce/callback

# Outlook sign-in (Admin › Integrations › Overview › Outlook sign-in) sends
# people back to ${PUBLIC_APP_URL}/api/auth/microsoft/callback. Set this only
# if that must be a different host.
# OUTLOOK_REDIRECT_URI=https://app.example.com/api/auth/microsoft/callback

# ----------------------------------------------------------------------------
# First-Run Admin Bootstrap (optional — alternative to the wizard form)
# ----------------------------------------------------------------------------
# When all three are set AND no approved Admin exists, the server will create
# this user automatically on startup. Becomes a no-op once an admin exists.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=ChangeMeStrongP@ssw0rd!
# BOOTSTRAP_ADMIN_NAME=Site Admin

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# Application Version (set by your CI / release pipeline)
VITE_APP_VERSION=v0.7.00

# ----------------------------------------------------------------------------
# Email / SMTP (configurable post-install via Settings → Email)
# ----------------------------------------------------------------------------
# These are the legacy fallbacks; the recommended path is to configure SMTP in
# the UI so credentials live encrypted in the database.
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# SENDGRID_API_KEY=

# ----------------------------------------------------------------------------
# Cloud Storage (optional — defaults to local disk under /app/uploads)
# ----------------------------------------------------------------------------
# Configure via Settings → Storage in the UI to keep credentials encrypted in
# the database. These env-var fallbacks are only honored when the DB has no
# storage configuration yet.
#
# AWS S3 / S3-compatible (MinIO, Cloudflare R2, Backblaze B2, etc.)
# CLOUD_STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=criteriaiq-uploads
# AWS_S3_ENDPOINT=                  # custom endpoint for S3-compatible services
#
# Google Cloud Storage
# CLOUD_STORAGE_PROVIDER=gcs
# GCS_PROJECT_ID=
# GCS_BUCKET=criteriaiq-uploads
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-key.json
#
# Azure Blob Storage
# CLOUD_STORAGE_PROVIDER=azure
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_CONTAINER=criteriaiq-uploads

# ----------------------------------------------------------------------------
# AI Providers (optional — configure under Configuration → AI Providers)
# ----------------------------------------------------------------------------
# When set, these are seeded into the ai_providers table on first boot.
# Once a provider exists in the DB, the env var is no longer read.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=                  # Google Gemini
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=

# ----------------------------------------------------------------------------
# Single Sign-On (Okta OIDC) — emergency escape hatch
# ----------------------------------------------------------------------------
# SSO is configured in the UI at Configuration → Integrations → Single
# Sign-On (stored in the sso_config table). This env var is purely an
# operator escape hatch: when set to "true", the OIDC routes refuse to
# initiate or complete a sign-in regardless of what the DB row says,
# and the landing page hides the "Continue with Okta" button. Use when
# you need to redeploy past an Okta misconfig without first reaching
# the admin UI. The DB row is left untouched.
# SSO_DISABLE=true

